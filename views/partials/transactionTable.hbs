<div class="stats-section" id="transactions-section">
    <h2>{{tableTitle}}</h2>
    <div id="transactions-content">
        <table class="transactions-table">
            <thead>
            <tr>
                <th data-column="id">ID</th>
                <th data-column="date">Дата</th>
                <th data-column="type">Тип</th>
                <th data-column="amount">Сумма</th>
                <th data-column="categoryName">Категория</th>
                <th data-column="comment">Комментарий</th>
                {{#if showUserDetails}}
                    <th data-column="userId">ID пользователя</th>
                    <th data-column="surname">Фамилия</th>
                    <th data-column="name">Имя</th>
                    <th data-column="patronymic">Отчество</th>
                {{/if}}
                {{#unless hideActions}}
                    <th>Действия</th>
                {{/unless}}
            </tr>
            </thead>
            <tbody id="transactions-body"></tbody>
        </table>
        {{#if showNoTransactions}}
            <div class="no-transactions">Транзакции отсутствуют</div>
        {{/if}}
    </div>
    {{{extraContent}}}
</div>