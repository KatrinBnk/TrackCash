<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="/js/auth.js"></script>
<script>
    $(document).ready(function() {
        $('#logout-btn').on('click', function(e) {
            e.preventDefault();
            $.ajax({
                url: '/api/auth/logout',
                method: 'POST',
                success: function() {
                    removeToken();
                    window.location.href = '/login';
                }
            });
        });
    });
</script>

