        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .manager-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1440px;
        margin: 0 auto;
    }

    .nav-brand {
        font-size: 24px;
