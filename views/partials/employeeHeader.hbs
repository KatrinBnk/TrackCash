<header class="manager-header">
    <nav class="manager-nav">
        <div class="nav-brand">
            <span onclick="window.location.href = '/employee'">CashTrack</span>
        </div>
        <ul class="nav-menu">
            <li><a href="/employee/transactions">Мои транзакции</a></li>
            <li><a href="/employee/statistics">Статистика</a></li>
            <li><a onclick="logout()">Выйти</a></li>
        </ul>
    </nav>
</header>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function logout() {
        // Очищаем localStorage
        localStorage.removeItem('token');

        $.ajax({
            url: '/api/auth/logout',
            method: 'POST',
            success: function (response) {
                window.location.href = '/login';
            },
            error: function (xhr) {
                console.error('Ошибка при выходе:', xhr.responseJSON?.message || 'Неизвестная ошибка');
            }
        });
    }
</script>

<style>
    .manager-header {
        background-color: #7255A5; /* Blue Violet для фона хедера */
