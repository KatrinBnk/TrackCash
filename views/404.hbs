<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Страница не найдена - CashTrack</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        body {
            margin: 0;
            font-family: 'Poppins', Arial, sans-serif;
            background-color: #F7F2E8;
            color: #1F2526;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .container {
            max-width: 600px;
            padding: 20px;
        }

        .error-code {
            font-size: 120px;
            font-weight: 700;
            color: #7255A5;
            margin-bottom: 20px;
        }

        .error-message {
            font-size: 24px;
            font-weight: 500;
            margin-bottom: 10px;
        }

        .error-description {
            font-size: 16px;
            font-weight: 400;
            color: #1F2526;
            margin-bottom: 30px;
        }

        .action-btn {
            padding: 12px 24px;
            background-color: #BBFBAC;
            color: #1F2526;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease, box-shadow 0.3s ease;
            font-family: 'Poppins', sans-serif;
            font-weight: 500;
            font-size: 16px;
            text-decoration: none;
            display: inline-block;
        }

        .action-btn:hover {
            background-color: #A5E698;
            box-shadow: 0 2px 8px rgba(165, 230, 152, 0.4);
        }

        .action-btn i {
            margin-right: 8px;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="error-code">404</div>
    <div class="error-message">Страница не найдена</div>
    <div class="error-description">
        К сожалению, запрашиваемая страница не существует.<br>
        Возможно, вы ввели неправильный адрес или страница была удалена.
    </div>
    <div id="action-button"></div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="/js/auth.js"></script>
<script>
    $(document).ready(function () {
        const token = getToken();
        const actionButtonContainer = $('#action-button');

        if (token) {
            // Если пользователь авторизирован, определяем его роль и домашнюю страницу
            $.ajax({
                url: '/api/users/me',
                method: 'GET',
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'Bearer ' + token);
                },
                success: function (user) {
                    console.log('Данные пользователя:', user);
                    let homeUrl = '/';
                    if (user.role === 'manager') {
                        homeUrl = '/manager';
                    } else if (user.role === 'employee') {
                        homeUrl = '/employee';
                    } else if (user.role === 'admin') {
                        homeUrl = '/admin';
                    }
                    actionButtonContainer.html(`
                            <a href="${homeUrl}" class="action-btn">
                                <i class="fas fa-home"></i> На главную страницу
                            </a>
                        `);
                },
                error: function (xhr) {
                    console.error('Ошибка получения данных пользователя:', xhr.responseJSON?.message || 'Неизвестная ошибка');
                    // Если не удалось получить данные пользователя, показываем кнопку логина
                    actionButtonContainer.html(`
                            <a href="/login" class="action-btn">
                                <i class="fas fa-sign-in-alt"></i> Войти
                            </a>
                        `);
                }
            });
        } else {
            // Если пользователь не авторизирован, показываем кнопку логина
            actionButtonContainer.html(`
                    <a href="/login" class="action-btn">
                        <i class="fas fa-sign-in-alt"></i> Войти
                    </a>
                `);
        }
    });
</script>
</body>
</html>